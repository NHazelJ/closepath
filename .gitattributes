# Store and check out text files with LF line endings on every OS,
# so Windows and macOS/Linux partners produce identical diffs.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated by npm: GitHub collapses it in PR diffs and leaves it out of
# language stats. Review dependency changes in package.json instead.
package-lock.json linguist-generated=true
