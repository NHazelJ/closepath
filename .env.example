# Example environment variables. This file is committed; real values are not.
# Copy what you need into .env.local (dev) and .env.test (tests). Both are git-ignored.
# In Vercel and GitHub Actions, set these as environment variables or secrets.

# Local PostgreSQL from `docker compose up -d` (local-only credentials, see compose.yaml).
# In .env.test, use the closepath_test database instead:
#   DATABASE_URL="postgresql://closepath:closepath@localhost:5432/closepath_test"
# In Vercel, this is Neon's pooled connection string.
DATABASE_URL="postgresql://closepath:closepath@localhost:5432/closepath_dev"

# Better Auth (added with Better Auth). The secret is 32+ random bytes, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET="replace-with-a-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Protects /api/cron/follow-ups (F3). Any long random string.
CRON_SECRET="replace-with-a-random-string"

# Optional. Without it, emails only go to the in-app outbox (/agent/outbox).
RESEND_API_KEY=""
